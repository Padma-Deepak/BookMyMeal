# Required in production — set these as Railway environment variables
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://...   # set automatically by Railway's Postgres plugin

# Optional — Railway sets RAILWAY_PUBLIC_DOMAIN automatically
# ALLOWED_HOSTS=yourdomain.railway.app

# Leave DEBUG unset (defaults to False) in production
# DEBUG=True   # only for local testing

# CORS — only needed if frontend is on a different domain
# CORS_ALLOWED_ORIGINS=https://yourdomain.railway.app
